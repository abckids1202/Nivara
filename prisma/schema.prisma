generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  CANCELLED
  PAYMENT_REVIEW
  PAID_REVIEW
}

enum FulfilmentStatus {
  PROCESSING
  SHIPPED
  DELIVERED
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentReviewAction {
  REFUND
  FULFIL
  CANCEL
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  displayName  String?
  isAdmin      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  addresses    Address[]
  wishlist     Wishlist?
  cart         Cart?
  orders       Order[]
  reviews      Review[]
  inventoryAdjustments InventoryAdjustment[]
  paymentReviewResolutions PaymentReviewResolution[]
  moderationActions ModerationAction[]
  auditLogs     AuditLog[]
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String?
  fullName     String
  line1       String
  city        String
  state       String
  postalCode  String
  country     String   @default("IN")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]
  createdAt   DateTime @default(now())
  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String
  material    String?
  dimensions  String?
  care        String?
  status      ProductStatus @default(DRAFT)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  images      ProductImage[]
  wishlistItems WishlistItem[]
  reviews     Review[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@index([categoryId, status])
  @@index([status, createdAt])
}

model ProductVariant {
  id          String                  @id @default(cuid())
  productId   String
  name        String
  sku         String                  @unique
  pricePaise  Int
  compareAtPaise Int?
  stockOnHand Int
  stockReserved Int                     @default(0)
  product     Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reservations InventoryReservation[]
  inventoryAdjustments InventoryAdjustment[]
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, sortOrder])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id        String   @id @default(cuid())
  wishlistId String
  productId String
  wishlist  Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([wishlistId, productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  guestKey  String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  @@unique([cartId, variantId])
}

model Order {
  id                String                @id @default(cuid())
  orderNumber       String                @unique
  userId            String?
  guestEmail        String?
  guestAccessHash   String?
  guestAccessExpiry DateTime?
  addressId         String?
  subtotalPaise     Int
  deliveryFeePaise  Int
  totalPaise        Int
  shippingFullName  String?
  shippingLine1     String?
  shippingCity      String?
  shippingState     String?
  shippingPostalCode String?
  shippingCountry   String?             @default("IN")
  paymentStatus     PaymentStatus         @default(CREATED)
  fulfilmentStatus  FulfilmentStatus      @default(PROCESSING)
  user              User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  address           Address?              @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  payments          PaymentAttempt[]
  reservations      InventoryReservation[]
  shipment          Shipment?
  paymentReviewResolution PaymentReviewResolution?
  guestAccessAttempts GuestOrderAccessAttempt[]
  emailDeliveries EmailDelivery[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  @@index([userId, createdAt])
  @@index([guestEmail])
}

model OrderItem {
  id            String         @id @default(cuid())
  orderId       String
  variantId     String
  productName   String
  variantName   String
  sku           String
  unitPricePaise Int
  quantity      Int
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  review        Review?
  @@index([orderId])
}

model PaymentAttempt {
  id              String        @id @default(cuid())
  orderId         String
  providerOrderId String?
  providerPaymentId String?
  idempotencyKey   String?             @unique
  refundReference  String?
  status          PaymentStatus @default(CREATED)
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events          PaymentEvent[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([orderId, status])
}

model PaymentEvent {
  id            String         @id @default(cuid())
  providerEventId String       @unique
  paymentAttemptId String?
  payloadHash   String
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  @@index([paymentAttemptId])
}

model InventoryReservation {
  id         String            @id @default(cuid())
  orderId    String
  variantId  String
  quantity   Int
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant    ProductVariant   @relation(fields: [variantId], references: [id])
  @@unique([orderId, variantId])
  @@index([status, expiresAt])
  @@index([variantId, status])
}

model Review {
  id           String       @id @default(cuid())
  productId    String
  orderItemId  String       @unique
  userId       String
  rating       Int
  body         String
  displayName  String
  status       ReviewStatus @default(PENDING)
  moderationReason String?
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  moderationActions ModerationAction[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  @@index([productId, status])
}

model Shipment {
  id            String   @id @default(cuid())
  orderId       String   @unique
  courierName   String?
  trackingReference String?
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  updatedAt     DateTime @updatedAt
}

model InventoryAdjustment {
  id            String         @id @default(cuid())
  variantId     String
  adminUserId   String
  quantityDelta Int
  beforeQuantity Int
  afterQuantity  Int
  reason        String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  adminUser     User           @relation(fields: [adminUserId], references: [id])
  createdAt     DateTime       @default(now())
  @@index([variantId, createdAt])
}

model PaymentReviewResolution {
  id              String             @id @default(cuid())
  orderId         String             @unique
  adminUserId     String
  action          PaymentReviewAction
  reason          String
  refundReference String?
  order           Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminUser       User               @relation(fields: [adminUserId], references: [id])
  createdAt       DateTime           @default(now())
  @@index([adminUserId, createdAt])
}

model ModerationAction {
  id             String       @id @default(cuid())
  reviewId       String
  adminUserId    String
  previousStatus ReviewStatus
  nextStatus     ReviewStatus
  reason         String
  review         Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  adminUser     User         @relation(fields: [adminUserId], references: [id])
  createdAt      DateTime     @default(now())
  @@index([reviewId, createdAt])
}

model GuestOrderAccessAttempt {
  id                String   @id @default(cuid())
  orderId           String?
  tokenHash         String?
  requestFingerprint String
  successful        Boolean  @default(false)
  order             Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  @@index([tokenHash, createdAt])
  @@index([requestFingerprint, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  details    Json?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model EmailDelivery {
  id                String              @id @default(cuid())
  orderId           String
  kind              String
  status            EmailDeliveryStatus @default(PENDING)
  providerMessageId String?
  errorMessage      String?
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  @@unique([orderId, kind])
  @@index([status, createdAt])
}
